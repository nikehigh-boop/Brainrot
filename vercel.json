{
  "headers": [
    {
      "source": "/feed.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        }
      ]
    },
    {
      "source": "/a/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/stats",
      "destination": "/stats.html"
    }
  ],
  "crons": [
    {
      "path": "/api/market?sync=gameflip",
      "schedule": "17 10 * * *"
    }
  ],
  "functions": {
    "api/market.js": {
      "maxDuration": 60
    }
  }
}
